{
	"check_interval": 300,
	"timeout": 30,
	"concurrent_requests": 50,
	"max_retries": 3,
	"retry_delay": 2,
	"ttl_dns_cache": 10,
	"force_close": false,
	"verify_ssl": true,
	"email_notification_level": "only_failures",
	"email": {
		"from": "sitemonitor@example.com",
		"to": "admin@example.com",
		"subject": "VNS.SiteMonitor Alert: Website Failures Detected",
		"priority": "high",
		"smtp": {
			"server": "smtp.example.com",
			"port": 587,
			"use_tls": true,
			"username": "your-username",
			"password": "your-password"
		}
	}
}
