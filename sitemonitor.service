[Unit]
Description=VNS.SiteMonitor Website Monitoring Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/sitemonitor
ExecStart=/usr/bin/python3 /opt/sitemonitor/sitemonitor.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security settings
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
